#!/bin/sh
# Void.app/Contents/MacOS/Void: the macOS branch of bin/void, run with the Python inside the bundle.
# Starts the server in the background if it isn't up, then becomes his Qt window (or hands the command to it).
#   open Void.app            show / hide him
#   open Void.app --args listen
set -eu
CONTENTS="$(cd "$(dirname "$0")/.." && pwd)"
PY="$CONTENTS/Resources/python/bin/python3"; APP="$CONTENTS/Resources/app"
ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/void"; LOG="$ROOT/server.log"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"   # Finder gives a bare PATH
# installed with ./install.sh too? that copy is the one kept up to date — open it, never this bundle's older one beside it
# (after PATH: started from the Dock, the installed Void and the Claude it runs still find Homebrew's tools)
[ -x "$HOME/.local/bin/void" ] && [ -x "$ROOT/venv/bin/python" ] && [ -f "$ROOT/app/server.py" ] && exec "$HOME/.local/bin/void" "$@"
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1    # nothing from ~/.local, nothing written into the signed bundle
mkdir -p "$ROOT"
PORT="$("$PY" "$APP/server.py" --print-port)"
URL="http://127.0.0.1:$PORT/"
# up = OUR server answers: its run id (/api/id) is the one in our runtime.json (another Void on the same port has its own, so we never attach to it)
# (a runtime.json with no id was written by an older server of ours, still running from before an update: that one's ours)
up(){ [ -f "$ROOT/runtime.json" ] || return 1
  ID="$(sed -n 's/.*"id": "\([0-9a-f]*\)".*/\1/p' "$ROOT/runtime.json")"
  [ -n "$ID" ] || { curl -fs --max-time 2 -o /dev/null "${URL}api/state"; return; }   # (an older server has no /api/id)
  case "$(curl -fs --max-time 2 "${URL}api/id")" in *"\"id\": \"$ID\""*) ;; *) return 1 ;; esac; }
if ! up; then
  set -m                                  # its own process group: quitting stops it with its children (resource tracker…)
  nohup "$PY" "$APP/server.py" >>"$LOG" 2>&1 </dev/null &
  SPID=$!; set +m
  for _ in $(seq 60); do up && break; sleep 0.1; done
  up || { echo "server didn't start — see $LOG" >&2; exit 1; }
  [ -z "$ID" ] || ! kill -0 "$SPID" 2>/dev/null || "$PY" "$APP/window_win.py" --started "$SPID" "$ID"   # ours: quit stops it (and only it)
fi
CMD="${1:-toggle}"
if pgrep -f "$APP/window_win.py" >/dev/null 2>&1; then exec "$PY" "$APP/window_win.py" "${URL}?native=1" "$CMD"; fi
[ "$CMD" = quit ] && { "$PY" "$APP/window_win.py" --stop-started; exit 0; }   # no window: the server is all there is to stop
[ "$CMD" = hide ] && exit 0
[ "$CMD" = toggle ] && CMD=show
exec "$PY" "$APP/window_win.py" "${URL}?native=1" "$CMD" >>"$LOG" 2>&1 </dev/null
